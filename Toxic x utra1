-- Cria/remove ESP de um player
local function buildESP(player)
    if player == LP then return end
    if ESPCache[player] then return end
    ESPCache[player] = {}

    local conn
    conn = RunService.Heartbeat:Connect(function()
        local esp = ESPCache[player]
        if not esp then conn:Disconnect() return end

        local char = player.Character
        if not char then
            for _, o in pairs(esp) do pcall(function() o:Destroy() end) end
            ESPCache[player] = {}
            return
        end

        local root = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        local hum  = char:FindFirstChildWhichIsA("Humanoid")
        if not root then return end

        local col = Rainbow(player.UserId * 0.01)

        -- BOX
        if State.ESP_Box then
            if not esp.Box then
                local b = Instance.new("SelectionBox")
                b.Color3 = col
                b.LineThickness = 0.05
                b.SurfaceTransparency = 0.85
                b.SurfaceColor3 = col
                b.Adornee = char
                b.Parent = ScreenGui
                esp.Box = b
            else
                esp.Box.Color3 = col
                esp.Box.SurfaceColor3 = col
                esp.Box.Adornee = char
            end
        elseif esp.Box then
            esp.Box:Destroy() esp.Box = nil
        end

        -- LINE (SelectionBox sobre HRP como referência de linha)
        if State.ESP_Line then
            if not esp.Line then
                local b = Instance.new("SelectionBox")
                b.Color3 = col
                b.LineThickness = 0.04
                b.SurfaceTransparency = 1
                b.Adornee = root
                b.Parent = ScreenGui
                esp.Line = b
            else
                esp.Line.Color3 = col
                esp.Line.Adornee = root
            end
        elseif esp.Line then
            esp.Line:Destroy() esp.Line = nil
        end

        -- HEALTH BAR
        if State.ESP_Health and hum then
            if not esp.HealthGui then
                local bb = Instance.new("BillboardGui")
                bb.Size = UDim2.new(0, 70, 0, 10)
                bb.StudsOffset = Vector3.new(0, 3.2, 0)
                bb.Adornee = root
                bb.AlwaysOnTop = true
                bb.Parent = ScreenGui

                local bg2 = Instance.new("Frame")
                bg2.Size = UDim2.new(1,0,1,0)
                bg2.BackgroundColor3 = Color3.fromRGB(30,0,0)
                bg2.BorderSizePixel = 0
                bg2.Parent = bb

                local bar = Instance.new("Frame")
                bar.Name = "Bar"
                bar.Size = UDim2.new(1,0,1,0)
                bar.BackgroundColor3 = col
                bar.BorderSizePixel = 0
                bar.Parent = bg2

                esp.HealthGui = bb
                esp.HealthBar = bar
            else
                esp.HealthGui.Adornee = root
                if esp.HealthBar then
                    local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                    esp.HealthBar.Size = UDim2.new(pct, 0, 1, 0)
                    esp.HealthBar.BackgroundColor3 = col
                end
            end
        elseif esp.HealthGui then
            esp.HealthGui:Destroy() esp.HealthGui = nil esp.HealthBar = nil
        end

        -- NAME TAG
        if State.ESP_Name then
            if not esp.NameGui then
                local bb = Instance.new("BillboardGui")
                bb.Size = UDim2.new(0, 130, 0, 34)
                bb.StudsOffset = Vector3.new(0, 5, 0)
                bb.Adornee = head or root
                bb.AlwaysOnTop = true
                bb.Parent = ScreenGui

                local dsp = Instance.new("TextLabel")
                dsp.Size = UDim2.new(1,0,0.55,0)
                dsp.BackgroundTransparency = 1
                dsp.Text = player.DisplayName
                dsp.TextColor3 = col
                dsp.TextSize = 13
                dsp.Font = Enum.Font.GothamBold
                dsp.TextStrokeTransparency = 0.4
                dsp.Parent = bb

                local usr = Instance.new("TextLabel")
                usr.Size = UDim2.new(1,0,0.45,0)
                usr.Position = UDim2.new(0,0,0.55,0)
                usr.BackgroundTransparency = 1
                usr.Text = "@" .. player.Name
                usr.TextColor3 = col
                usr.TextSize = 10
                usr.Font = Enum.Font.Gotham
                usr.TextStrokeTransparency = 0.4
                usr.Parent = bb

                esp.NameGui = bb
                esp.NameDsp = dsp
                esp.NameUsr = usr
            else
                esp.NameGui.Adornee = head or root
                if esp.NameDsp then
                    esp.NameDsp.TextColor3 = col
                    esp.NameDsp.Text = player.DisplayName
                end
                if esp.NameUsr then
                    esp.NameUsr.TextColor3 = col
                end
            end
        elseif esp.NameGui then
            esp.NameGui:Destroy() esp.NameGui = nil
            esp.NameDsp = nil esp.NameUsr = nil
        end
    end)

    -- Remove ESP quando player sair do jogo
    player.AncestryChanged:Connect(function()
        if not player.Parent then
            local esp = ESPCache[player]
            if esp then
