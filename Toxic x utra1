        char.HumanoidRootPart.CFrame = cf
    end
end

local function TP_Tween(targetHRP)
    local char = lp.Character
    if not char then return end
    local HRP      = char:FindFirstChild("HumanoidRootPart")
    local Humanoid = char:FindFirstChild("Humanoid")
    if not HRP or not Humanoid then return end
    HRP.AssemblyLinearVelocity  = Vector3.zero
    HRP.AssemblyAngularVelocity = Vector3.zero
    Humanoid:ChangeState(Enum.HumanoidStateType.Physics)
    local predictedPos = targetHRP.Position + (targetHRP.Velocity * PredictionStrength)
    local targetCFrame =
        CFrame.new(predictedPos)
        * CFrame.Angles(0, math.rad(targetHRP.Orientation.Y), 0)
        * CFrame.new(XOffset, YOffset, ZOffset)
    local Distance = (targetCFrame.Position - HRP.Position).Magnitude
    local hDist = math.sqrt((targetCFrame.Position.X - HRP.Position.X)^2 + (targetCFrame.Position.Z - HRP.Position.Z)^2)
    local vDist = math.abs(targetCFrame.Position.Y - HRP.Position.Y)
    local speed = vDist > hDist and TweenSpeed.Y or TweenSpeed.X
    if ActiveTween then ActiveTween:Cancel() end
    ActiveTween = TweenService:Create(HRP, TweenInfo.new(Distance / speed, Enum.EasingStyle.Linear), { CFrame = targetCFrame })
    ActiveTween:Play()
    task.delay(0.05, function() if Humanoid then Humanoid:ChangeState(Enum.HumanoidStateType.Running) end end)
end

local function AttackMultipleTargets(targets)
    pcall(function()
        if not targets or #targets == 0 then return end
        local allTargets = {}
        for _, char in pairs(targets) do
            local head = char:FindFirstChild("Head")
            if head then table.insert(allTargets, { char, head }) end
        end
        if #allTargets == 0 then return end
        RegisterAttack:FireServer(0)
        RegisterHit:FireServer(allTargets[1][2], allTargets)
    end)
end

