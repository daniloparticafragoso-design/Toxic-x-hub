-- // ESP
local function GetESPForPlayer(player)
    if not ESPObjects[player] then
        ESPObjects[player] = { Box = nil, Line = nil, NameTag = nil }
    end
    return ESPObjects[player]
end

local function RemoveESP(player)
    if ESPObjects[player] then
        for _, obj in pairs(ESPObjects[player]) do
            if obj then pcall(function() obj:Remove() end) end
        end
        ESPObjects[player] = nil
    end
end

local function UpdateESP()
    local rainbow = Settings.ESP_Rainbow
    local hue = (tick() % 5) / 5
    local rainbowColor = Color3.fromHSV(hue, 1, 1)

    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end

        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        local esp = GetESPForPlayer(player)

        if not root or not humanoid or humanoid.Health <= 0 then
            RemoveESP(player)
            continue
        end

        local espColor = rainbow and rainbowColor or Color3.fromRGB(120, 40, 255)

        -- Box
        if Settings.ESP_Box then
            if not esp.Box then
                local box = Drawing.new("Square")
                box.Visible = false
                box.Color = espColor
                box.Thickness = 2
                box.Filled = false
                esp.Box = box
            end
            local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
            local topPos = Camera:WorldToViewportPoint(root.Position + Vector3.new(0, 3, 0))
            local botPos = Camera:WorldToViewportPoint(root.Position + Vector3.new(0, -3, 0))
            if onScreen then
                local height = math.abs(topPos.Y - botPos.Y)
                local width = height * 0.6
                esp.Box.Size = Vector2.new(width, height)
                esp.Box.Position = Vector2.new(screenPos.X - width/2, screenPos.Y - height/2)
                esp.Box.Color = espColor
                esp.Box.Visible = true
            else
                esp.Box.Visible = false
            end
        elseif esp.Box then
            esp.Box.Visible = false
        end

        -- Linha
        if Settings.ESP_Line then
            if not esp.Line then
                local line = Drawing.new("Line")
                line.Visible = false
                line.Color = espColor
                line.Thickness = 2
                esp.Line = line
            end
            local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
            if onScreen then
                esp.Line.From = Vector2.new(screenPos.X, screenPos.Y)
                esp.Line.To = Vector2.new(Camera.ViewportSize.X / 2, 0)
                esp.Line.Color = espColor
                esp.Line.Visible = true
            else
                esp.Line.Visible = false
            end
        elseif esp.Line then
            esp.Line.Visible = false
        end

        -- Nome
        if Settings.ESP_Name then
            if not esp.NameTag then
                local nameTag = Drawing.new("Text")
                nameTag.Visible = false
                nameTag.Color = espColor
                nameTag.Size = 14
                nameTag.Center = true
                nameTag.Outline = true
                nameTag.Font = Drawing.Fonts.UI
                esp.NameTag = nameTag
            end
            local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position + Vector3.new(0, 3.5, 0))
            if onScreen then
                esp.NameTag.Text = player.Name
                esp.NameTag.Position = Vector2.new(screenPos.X, screenPos.Y)
                esp.NameTag.Color = espColor
                esp.NameTag.Visible = true
            else
                esp.NameTag.Visible = false
            end
        elseif esp.NameTag then
            esp.NameTag.Visible = false
        end
    end
end

-- // Aimbot - Distância real + Raycast (anti-parede) + 360° lock
local function IsVisible(targetRoot)
    -- Monta lista de partes pra ignorar (nosso char + target char)
    local myChar = LocalPlayer.Character
    local targetChar = targetRoot.Parent

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local ignoreList = {}
    if myChar then
        for _, p in pairs(myChar:GetDescendants()) do
            if p:IsA("BasePart") then table.insert(ignoreList, p) end
        end
    end
    if targetChar then
        for _, p in pairs(targetChar:GetDescendants()) do
            if p:IsA("BasePart") then table.insert(ignoreList, p) end
        end
    end
    rayParams.FilterDescendantsInstances = ignoreList

    local origin = Camera.CFrame.Position
    local direction = (targetRoot.Position - origin)
    local result = workspace:Raycast(origin, direction, rayParams)

    -- Se nao bateu em nada = visivel
    return result == nil
end

local function GetNearestPlayer()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local bestTarget = nil
    local bestScore = math.huge -- menor score = melhor alvo

    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid or humanoid.Health <= 0 then continue end

        -- Distância real no mundo (360°, sem limite de tela)
        local dist = (root.Position - myRoot.Position).Magnitude

        -- Verificar se está visível (sem parede na frente)
        local visible = IsVisible(root)

        -- Score: players visíveis têm prioridade (bonus de distância menor)
        -- Se invisível (atrás de parede), penaliza com +1000
        local score = dist + (visible and 0 or 1000)

        if score < bestScore then
            bestScore = score
            bestTarget = root
        end
    end

    return bestTarget
end

-- // HitBox
local function ApplyHitBox()
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") and Settings.HitBox then
                    part.Size = Vector3.new(Settings.HitBoxSize, Settings.HitBoxSize, Settings.HitBoxSize)
                end
            end
        end
    end
end

-- // Spin
local spinAngle = 0
local function DoSpin()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root and Settings.Spin then
        spinAngle = (spinAngle + Settings.SpinSpeed * 0.1) % 360
        root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, math.rad(spinAngle), 0)
    end
end

