    valLabel.Font = Enum.Font.GothamBold
    valLabel.TextSize = 12
    valLabel.TextXAlignment = Enum.TextXAlignment.Right
    valLabel.Parent = row

    local trackBg = Instance.new("Frame")
    trackBg.Size = UDim2.new(1, -24, 0, 4)
    trackBg.Position = UDim2.new(0, 12, 0, 38)
    trackBg.BackgroundColor3 = Color3.fromRGB(60, 60, 65)
    trackBg.BorderSizePixel = 0
    trackBg.Parent = row
    Instance.new("UICorner", trackBg).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
    fill.BorderSizePixel = 0
    fill.Parent = trackBg
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local knobSlider = Instance.new("Frame")
    knobSlider.Size = UDim2.new(0, 14, 0, 14)
    knobSlider.AnchorPoint = Vector2.new(0.5, 0.5)
    knobSlider.Position = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 0.5, 0)
    knobSlider.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knobSlider.BorderSizePixel = 0
    knobSlider.Parent = trackBg
    Instance.new("UICorner", knobSlider).CornerRadius = UDim.new(1, 0)

    local dragging = false
    local hitbox = Instance.new("TextButton")
    hitbox.Size = UDim2.new(1, 0, 0, 24)
    hitbox.Position = UDim2.new(0, 0, 0, -10)
    hitbox.BackgroundTransparency = 1
    hitbox.Text = ""
    hitbox.Parent = trackBg

    local function updateSlider(inputX)
        local absX = trackBg.AbsolutePosition.X
        local absW = trackBg.AbsoluteSize.X
        local ratio = math.clamp((inputX - absX) / absW, 0, 1)
        local value = math.floor(minVal + (maxVal - minVal) * ratio)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        knobSlider.Position = UDim2.new(ratio, 0, 0.5, 0)
        valLabel.Text = tostring(value)
        callback(value)
    end

    hitbox.MouseButton1Down:Connect(function()
        dragging = true
        updateSlider(UserInputService:GetMouseLocation().X)
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateSlider(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)

    return row
end

