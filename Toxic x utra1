local camera = workspace.CurrentCamera

RunService.Heartbeat:Connect(function()
    if not (ESPNames or ESPBoxes or ESPLines or ESPHealth) then return end
    local myChar = lp.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    for playerName, data in pairs(ESPData) do
        if not data.hrp or not data.hrp.Parent then removeESP(playerName) end
        if ESPNames and myHRP and data.distLabel and data.distLabel.Parent then
            data.distLabel.Text = math.floor((data.hrp.Position - myHRP.Position).Magnitude) .. "m"
        end
        if ESPLines and data.line then
            local headPos, onScreen = camera:WorldToViewportPoint(data.hrp.Position + Vector3.new(0,2,0))
            if onScreen then
                data.line.Visible = true
                data.line.From = Vector2.new(headPos.X, headPos.Y)
                data.line.To   = Vector2.new(camera.ViewportSize.X / 2, 0)
            else
                data.line.Visible = false
            end
        end
        if ESPHealth and data.hpFill and data.hpLabel then
            local tPlayer = Players:FindFirstChild(playerName)
            local tChar   = tPlayer and tPlayer.Character
            if tChar then
                local hum = tChar:FindFirstChild("Humanoid")
                if hum then
                    local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    data.hpFill.Size = UDim2.new(ratio, 0, 1, 0)
                    local r = math.floor((1 - ratio) * 255)
                    local g = math.floor(ratio * 220)
                    data.hpFill.BackgroundColor3 = Color3.fromRGB(r, g, 30)
                    data.hpLabel.Text = "HP: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)
                end
            end
        end
    end
end)

