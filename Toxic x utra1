local HitboxEnabled   = false
local HitboxSize      = 10
local HitboxOriginals = {}
local HitboxConn      = nil

local function expandHitboxes()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= lp and player.Character then
            for _, part in pairs(player.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    local key = player.Name .. "_" .. part.Name
                    if not HitboxOriginals[key] then
                        HitboxOriginals[key] = {
                            size         = part.Size,
                            transparency = part.Transparency,
                        }
                    end
                    part.Size         = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
                    part.Transparency = 0.8
                    part.CanCollide   = false
                end
            end
        end
    end
end

local function restoreHitboxes()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= lp and player.Character then
            for _, part in pairs(player.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    local key = player.Name .. "_" .. part.Name
                    if HitboxOriginals[key] then
                        part.Size         = HitboxOriginals[key].size
                        part.Transparency = HitboxOriginals[key].transparency
                        HitboxOriginals[key] = nil
                    end
                end
            end
        end
    end
end

addSectionHeader(page9, "📦 HITBOX EXPANDER")

addToggle(page9, "Expandir Hitbox", "Aumenta a hitbox dos players", function(v)
    HitboxEnabled = v
    if v then
        expandHitboxes()
        if HitboxConn then HitboxConn:Disconnect() end
        HitboxConn = RunService.Heartbeat:Connect(function()
            if not HitboxEnabled then return end
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= lp and player.Character then
                    for _, part in pairs(player.Character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            local key = player.Name .. "_" .. part.Name
                            if not HitboxOriginals[key] then
                                HitboxOriginals[key] = {
                                    size         = part.Size,
                                    transparency = part.Transparency,
                                }
                            end
                            part.Size         = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
                            part.CanCollide   = false
                            part.Transparency = 0.8
                        end
                    end
                end
            end
        end)
        Players.PlayerAdded:Connect(function(player)
            player.CharacterAdded:Connect(function()
                task.wait(0.5)
                if HitboxEnabled then expandHitboxes() end
            end)
        end)
    else
        if HitboxConn then HitboxConn:Disconnect(); HitboxConn = nil end
        restoreHitboxes()
    end
end)

