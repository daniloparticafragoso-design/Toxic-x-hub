local function buildESP(player)
    if ESPData[player.Name] then
        pcall(function() ESPData[player.Name].billboard:Destroy() end)
        pcall(function() ESPData[player.Name].box:Destroy() end)
        pcall(function() ESPData[player.Name].line:Remove() end)
        ESPData[player.Name] = nil
    end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local data = { hrp = hrp }

    -- Billboard (nome + distância)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ToxicESP"
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 130, 0, 42)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.Parent = hrp
    data.billboard = billboard

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0.55, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = currentRainbow
    nameLabel.Font = Enum.Font.GothamBlack
    nameLabel.TextSize = 14
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    nameLabel.Visible = ESPNames
    nameLabel.Parent = billboard
    data.nameLabel = nameLabel

    local distLabel = Instance.new("TextLabel")
    distLabel.Size = UDim2.new(1, 0, 0.45, 0)
    distLabel.Position = UDim2.new(0, 0, 0.55, 0)
    distLabel.BackgroundTransparency = 1
    distLabel.Text = "0m"
    distLabel.TextColor3 = currentRainbow
    distLabel.Font = Enum.Font.GothamBold
    distLabel.TextSize = 11
    distLabel.TextStrokeTransparency = 0
    distLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    distLabel.Visible = ESPNames
    distLabel.Parent = billboard
    data.distLabel = distLabel

    -- Box (SelectionBox 3D)
    local selBox = Instance.new("SelectionBox")
    selBox.Adornee = char
    selBox.Color3 = currentRainbow
    selBox.LineThickness = 0.04
