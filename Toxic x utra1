            local bestPet = nil
            local bestLevel = -1

            if petFolder then
                for _, pet in ipairs(petFolder:GetChildren()) do
                    local lvl = pet:FindFirstChild("Level")
                           or pet:FindFirstChild("Nivel")
                           or pet:FindFirstChild("Rank")
                    local val = lvl and (lvl.Value or 0) or 0
                    if val > bestLevel then
                        bestLevel = val
                        bestPet = pet
                    end
                end
            end

            if bestPet then
                -- Dispara remote de equipar
                for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
                    if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
                        local rn = remote.Name:lower()
                        if rn:find("equip") or rn:find("pet") then
                            if remote:IsA("RemoteEvent") then
                                remote:FireServer(bestPet.Name)
                            else
                                remote:InvokeServer(bestPet.Name)
                            end
                        end
                    end
                end
            end
        end)
    end
end)

