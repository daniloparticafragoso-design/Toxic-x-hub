addToggle(page4, "Auto V4", "Ativa V4 automaticamente", function(v)
    autoV4 = v
    if v then
        if v4Connection then task.cancel(v4Connection); v4Connection = nil end
        v4Connection = task.spawn(function()
            while autoV4 do
                task.wait(0.5)
                pcall(function()
                    -- Método 1: scan no Net (Modules)
                    local net = ReplicatedStorage:FindFirstChild("Modules")
                    if net then
                        local n = net:FindFirstChild("Net")
                        if n then
                            for _, remote in pairs(n:GetDescendants()) do
                                local name = remote.Name:lower()
                                if name:find("v4") or name:find("awaken") or name:find("race") then
                                    if remote:IsA("RemoteEvent") then
                                        pcall(function() remote:FireServer(true) end)
                                    elseif remote:IsA("RemoteFunction") then
                                        pcall(function() remote:InvokeServer(true) end)
                                    end
                                end
                            end
                        end
                    end

                    -- Método 2: scan na Backpack do player
                    for _, tool in pairs(lp.Backpack:GetChildren()) do
                        for _, remote in pairs(tool:GetDescendants()) do
                            local name = remote.Name:lower()
                            if name:find("v4") or name:find("awaken") or name:find("race") then
                                if remote:IsA("RemoteEvent") then
                                    pcall(function() remote:FireServer(true) end)
                                elseif remote:IsA("RemoteFunction") then
                                    pcall(function() remote:InvokeServer(true) end)
                                end
                            end
                        end
                    end

                    -- Método 3: scan geral no ReplicatedStorage
                    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                        local name = remote.Name:lower()
                        if name:find("v4") or name:find("awaken") then
                            if remote:IsA("RemoteEvent") then
                                pcall(function() remote:FireServer(true) end)
                            elseif remote:IsA("RemoteFunction") then
                                pcall(function() remote:InvokeServer(true) end)
                            end
                        end
                    end
                end)
            end
        end)
    else
        if v4Connection then task.cancel(v4Connection); v4Connection = nil end
    end
end)

