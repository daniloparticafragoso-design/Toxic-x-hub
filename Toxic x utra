                data.nameLabel.TextColor3 = currentRainbow
            end
            if data.distLabel and data.distLabel.Parent then
                data.distLabel.TextColor3 = currentRainbow
            end
            if data.box and data.box.Parent then
                data.box.Color3 = currentRainbow
            end
            if data.line then
                data.line.Color = currentRainbow
            end
        end
    end
end)

local function buildESP(player)
    if ESPData[player.Name] then
        pcall(function() ESPData[player.Name].billboard:Destroy() end)
        pcall(function() ESPData[player.Name].box:Destroy() end)
        pcall(function() ESPData[player.Name].line:Remove() end)
        ESPData[player.Name] = nil
    end

    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local data = { hrp = hrp }

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ToxicESP_Name"
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 130, 0, 42)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.Parent = hrp
    data.billboard = billboard

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0.55, 0)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.Name
    nameLabel.TextColor3 = currentRainbow
    nameLabel.Font = Enum.Font.GothamBlack
    nameLabel.TextSize = 14
    nameLabel.TextStrokeTransparency = 0
    nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    nameLabel.Visible = ESPNames
    nameLabel.Parent = billboard
    data.nameLabel = nameLabel

    local distLabel = Instance.new("TextLabel")
    distLabel.Size = UDim2.new(1, 0, 0.45, 0)
    distLabel.Position = UDim2.new(0, 0, 0.55, 0)
    distLabel.BackgroundTransparency = 1
    distLabel.Text = "0m"
    distLabel.TextColor3 = currentRainbow
    distLabel.Font = Enum.Font.GothamBold
    distLabel.TextSize = 11
    distLabel.TextStrokeTransparency = 0
    distLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
    distLabel.Visible = ESPNames
    distLabel.Parent = billboard
    data.distLabel = distLabel

    local selBox = Instance.new("SelectionBox")
    selBox.Adornee = char
    selBox.Color3 = currentRainbow
    selBox.LineThickness = 0.04
    selBox.SurfaceTransparency = 1
    selBox.Visible = ESPBoxes
    selBox.Parent = ScreenGui
    data.box = selBox

    local line = Drawing.new("Line")
    line.Visible = ESPLines
    line.Thickness = 1.5
    line.Color = currentRainbow
    line.ZIndex = 5
    data.line = line

    ESPData[player.Name] = data
end

local function removeESP(playerName)
    local data = ESPData[playerName]
    if not data then return end
    pcall(function() data.billboard:Destroy() end)
    pcall(function() data.box:Destroy() end)
    pcall(function() data.line:Remove() end)
    ESPData[playerName] = nil
end

local function refreshAllESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= lp then buildESP(player) end
    end
end

Players.PlayerAdded:Connect(function(player)
    if ESPNames or ESPBoxes or ESPLines then
        task.wait(1); buildESP(player)
    end
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        if ESPNames or ESPBoxes or ESPLines then buildESP(player) end
    end)
end)

Players.PlayerRemoving:Connect(function(player)
    removeESP(player.Name)
end)

local camera = workspace.CurrentCamera

RunService.Heartbeat:Connect(function()
    if not (ESPNames or ESPBoxes or ESPLines) then return end
    local myChar = lp.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for playerName, data in pairs(ESPData) do
        if not data.hrp or not data.hrp.Parent then
            removeESP(playerName); continue
        end
        if ESPNames and myHRP then
            local dist = math.floor((data.hrp.Position - myHRP.Position).Magnitude)
            if data.distLabel and data.distLabel.Parent then
                data.distLabel.Text = dist .. "m"
            end
        end
        if ESPLines and data.line then
            local headPos, onScreen = camera:WorldToViewportPoint(data.hrp.Position + Vector3.new(0, 2, 0))
            if onScreen then
                data.line.Visible = true
                data.line.From = Vector2.new(headPos.X, headPos.Y)
                data.line.To   = Vector2.new(camera.ViewportSize.X / 2, 0)
            else
                data.line.Visible = false
            end
        end
    end
end)

